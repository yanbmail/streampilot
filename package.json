{
  "name": "streampilot",
  "productName": "StreamPilot",
  "version": "1.2.1",
  "description": "跨平台推流控制台：多协议推流、屏幕区域采集、IPTV 电视源聚合与转推",
  "author": "yanbmail",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanbmail/streampilot.git"
  },
  "homepage": "https://github.com/yanbmail/streampilot#readme",
  "bugs": {
    "url": "https://github.com/yanbmail/streampilot/issues"
  },
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/launch.js",
    "serve": "node server/index.js",
    "dev": "STREAMPILOT_DEV=1 node scripts/launch.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.8.0",
    "node-media-server": "^4.4.6"
  },
  "devDependencies": {
    "electron": "^33.2.0"
  },
  "build": {
    "appId": "com.streampilot.app",
    "productName": "StreamPilot",
    "files": [
      "electron/**/*",
      "server/**/*",
      "web/**/*",
      "node_modules/hls.js/dist/hls.min.js",
      "node_modules/mpegts.js/dist/mpegts.js",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/.cache/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "用于将摄像头画面作为推流源",
        "NSMicrophoneUsageDescription": "用于采集麦克风声音",
        "NSScreenCaptureDescription": "用于采集屏幕或屏幕区域作为推流源"
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    }
  }
}
